  journalLine: 
  loreId: 
  needsPower: 1
  unpoweredPrompt: "\u0422\u0435\u0440\u043C\u0438\u043D\u0430\u043B \u043E\u0445\u0440\u0430\u043D\u044B
    (\u043D\u0435\u0442 \u043F\u0438\u0442\u0430\u043D\u0438\u044F)"
  unpoweredMessage: "\u041D\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442.
