--- !u!114 &1829409959
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1829409957}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8559d1e585ee54143b906361e7f3790b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AshenWoods.Interaction.InfoPoint
  prompt: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043D\u043E\u0443\u0442\u0431\u0443\u043A"
  message: "\u0410\u0412\u0410\u0420\u0418\u0419\u041D\u042B\u0419 \u0420\u0415\u0416\u0418\u041C.
    \u041F\u0418\u0422\u0410\u041D\u0418\u0415 \u041E\u0422 \u0410\u041A\u041A\u0423\u041C\u0423\u041B\u042F\u0422\u041E\u0420\u0410.\n\n\u0412\u0421\u0415\u041C\u0423
    \u041F\u0415\u0420\u0421\u041E\u041D\u0410\u041B\u0423, \u041E\u0421\u0422\u0410\u0412\u0428\u0415\u041C\u0423\u0421\u042F
    \u041D\u0410 \u0421\u0422\u0410\u041D\u0426\u0418\u0418\n\u041E\u0431\u044A\u0435\u043A\u0442
    B-7 \u043F\u043E\u043A\u0438\u043D\u0443\u043B \u043A\u0430\u043C\u0435\u0440\u0443.
    \u041E\u043D \u043E\u0445\u043E\u0442\u0438\u0442\u0441\u044F \u043D\u0430 \u0437\u0432\u0443\u043A
    \u0438 \u043F\u043B\u043E\u0445\u043E \u0432\u0438\u0434\u0438\u0442 \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435,
    \u043D\u043E \u0437\u0430\u043C\u0435\u0442\u0438\u0442 \u043B\u044E\u0431\u043E\u0439
    \u0441\u0432\u0435\u0442.\n\n\u2014 \u0414\u0432\u0438\u0433\u0430\u0439\u0442\u0435\u0441\u044C
    \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E. \u0411\u0435\u0433 \u0441\u043B\u044B\u0448\u0435\u043D
    \u0447\u0435\u0440\u0435\u0437 \u0432\u0435\u0441\u044C \u0446\u0435\u0445.\n\u2014
    \u0415\u0441\u043B\u0438 \u043E\u0431\u044A\u0435\u043A\u0442 \u0432\u0430\u0441
    \u0437\u0430\u043C\u0435\u0442\u0438\u043B, \u0443\u0439\u0434\u0438\u0442\u0435
    \u0438\u0437 \u043F\u043E\u043B\u044F \u0437\u0440\u0435\u043D\u0438\u044F \u0438
    \u0443\u043A\u0440\u043E\u0439\u0442\u0435\u0441\u044C \u0432 \u0448\u043A\u0430\u0444\u0447\u0438\u043A\u0435
    \u0438\u043B\u0438 \u043F\u043E\u0434 \u0441\u0442\u043E\u043B\u043E\u043C.\n\u2014
    \u0412 \u0443\u043A\u0440\u044B\u0442\u0438\u0438 \u043D\u0435 \u0434\u044B\u0448\u0438\u0442\u0435,
    \u043F\u043E\u043A\u0430 \u043E\u043D \u0440\u044F\u0434\u043E\u043C: \u0434\u044B\u0445\u0430\u043D\u0438\u0435
    \u0437\u0430 \u0434\u0432\u0435\u0440\u0446\u0435\u0439 \u043E\u043D \u0441\u043B\u044B\u0448\u0438\u0442.\n\u2014
    \u0412\u0441\u043F\u044B\u0448\u043A\u0430 \u0444\u043E\u043D\u0430\u0440\u044F
    \u0441\u0431\u0438\u0432\u0430\u0435\u0442 \u0435\u0433\u043E \u0441 \u043D\u043E\u0433
    \u043D\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u0435\u043A\u0443\u043D\u0434.\n\u2014
    \u0411\u0440\u043E\u0448\u0435\u043D\u043D\u0430\u044F \u0431\u0443\u0442\u044B\u043B\u043A\u0430
    \u0438\u043B\u0438 \u0431\u0430\u043D\u043A\u0430 \u0443\u0432\u0435\u0434\u0451\u0442
    \u0435\u0433\u043E \u043D\u0430 \u0448\u0443\u043C.\n\n\u042D\u0412\u0410\u041A\u0423\u0410\u0426\u0418\u042F
    \u2014 \u0447\u0435\u0440\u0435\u0437 \u0432\u043E\u0440\u043E\u0442\u0430 \u043F\u043E\u0433\u0440\u0443\u0437\u043E\u0447\u043D\u043E\u0439
    \u0437\u043E\u043D\u044B \u0432 \u0441\u0431\u043E\u0440\u043E\u0447\u043D\u043E\u043C
    \u0446\u0435\u0445\u0435. \u0427\u0442\u043E\u0431\u044B \u0438\u0445 \u043F\u043E\u0434\u043D\u044F\u0442\u044C,
    \u043D\u0443\u0436\u043D\u043E:\n1. \u0412\u043A\u043B\u044E\u0447\u0438\u0442\u044C
    \u0440\u0443\u0431\u0438\u043B\u044C\u043D\u0438\u043A\u0438 \u0432 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u0449\u0438\u0442\u043E\u0432\u043E\u0439.
    \u0415\u0451 \u0434\u0432\u0435\u0440\u044C \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
    \u043A\u043B\u044E\u0447-\u043A\u0430\u0440\u0442\u0430 \u043E\u0445\u0440\u0430\u043D\u044B
    \u0438\u0437 \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0430 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438,
    \u0430 \u043A\u043E\u0434 \u043E\u0442 \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0430
    \u0437\u043D\u0430\u043B\u0430 \u043D\u043E\u0447\u043D\u0430\u044F \u0441\u043C\u0435\u043D\u0430.\n2.
    \u0417\u0430\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440
    \u2014 \u043A\u0430\u043D\u0438\u0441\u0442\u0440\u044B \u043D\u0430 \u0441\u043A\u043B\u0430\u0434\u0435.\n3.
    \u041E\u0442\u043A\u0440\u044B\u0442\u044C \u0432\u0435\u043D\u0442\u0438\u043B\u0438
    \u0433\u0438\u0434\u0440\u0430\u0432\u043B\u0438\u043A\u0438 \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0435
    \u043F\u043E\u0434 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u0449\u0438\u0442\u043E\u0432\u043E\u0439.\n\n\u041D\u0435
    \u0448\u0443\u043C\u0438\u0442\u0435. \u041D\u0435 \u0436\u0434\u0438\u0442\u0435
    \u043F\u043E\u043C\u043E\u0449\u0438."
  showAsSheet: 1
  sheetTitle: "\u0422\u0415\u0420\u041C\u0418\u041D\u0410\u041B \u0414\u0415\u0416\u0423\u0420\u041D\u041E\u0413\u041E"
  showMap: 0
  markEnemies: 0
  useNoise: 0
  journalLine: "\u0412\u044B\u0445\u043E\u0434 \u2014 \u0432\u043E\u0440\u043E\u0442\u0430
    \u043F\u043E\u0433\u0440\u0443\u0437\u043E\u0447\u043D\u043E\u0439 \u0437\u043E\u043D\u044B.
    \u041D\u0443\u0436\u043D\u044B: \u043A\u043B\u044E\u0447-\u043A\u0430\u0440\u0442\u0430
    (\u043A\u0430\u0431\u0438\u043D\u0435\u0442 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438),
    \u0440\u0443\u0431\u0438\u043B\u044C\u043D\u0438\u043A\u0438, \u0442\u043E\u043F\u043B\u0438\u0432\u043E,
    \u0433\u0438\u0434\u0440\u0430\u0432\u043B\u0438\u043A\u0430."
  loreId: 
  needsPower: 0
  unpoweredPrompt: "\u041D\u043E\u0443\u0442\u0431\u0443\u043A (\u043D\u0435\u0442
    \u043F\u0438\u0442\u0430\u043D\u0438\u044F)"
  unpoweredMessage: "\u041D\u0435 \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F.
    \u0412\u043E \u0432\u0441\u0451\u043C \u0437\u0434\u0430\u043D\u0438\u0438 \u043D\u0435\u0442
    \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u0430."
  screen: {fileID: 1821611400}
  screenOff: {fileID: 2100000, guid: ac633c275dec16e4c9a8bdea20282221, type: 2}
  screenOn: {fileID: 2100000, guid: dbccf73d5aa50da40ac87c27a34d190d, type: 2}
  poweredMessage: "\u041F\u0438\u0442\u0430\u043D\u0438\u0435 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043E.\n\n\u041D\u0430\u0440\u0443\u0448\u0435\u043D\u0430
    \u0438\u0437\u043E\u043B\u044F\u0446\u0438\u044F B-7. \u041E\u0431\u044A\u0435\u043A\u0442
    \u043D\u0430 \u0441\u0432\u043E\u0431\u043E\u0434\u0435.\n\u041E\u0445\u043E\u0442\u0438\u0442\u0441\u044F
    \u043D\u0430 \u0437\u0432\u0443\u043A, \u0438\u0437\u0431\u0435\u0433\u0430\u0435\u0442
    \u044F\u0440\u043A\u043E\u0433\u043E \u0441\u0432\u0435\u0442\u0430.\n\n\u042D\u0432\u0430\u043A\u0443\u0438\u0440\u0443\u0439\u0442\u0435\u0441\u044C
    \u0447\u0435\u0440\u0435\u0437 \u043F\u043E\u0433\u0440\u0443\u0437\u043E\u0447\u043D\u0443\u044E
    \u0437\u043E\u043D\u0443.\n\u041D\u0430\u0441 \u043D\u0435 \u0436\u0434\u0438\u0442\u0435.\n\n\u2014
    \u2014 \u2014"
  showControls: 1
