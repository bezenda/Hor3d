--- !u!114 &1857526694
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1857526693}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2d6af1e732e248c09586c3a68f02a262, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AshenWoods.GameManagement.ObjectiveManager
  steps:
  - id: torch
    description: "\u041D\u0430\u0439\u0434\u0438 \u0444\u043E\u043D\u0430\u0440\u044C.
      \u041E\u043D \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u0442\u044C
      \u043D\u0430 \u0441\u0442\u043E\u043B\u0435 \u0443\u0431\u043E\u0440\u0449\u0438\u043A\u0430."
    condition: 1
    keyId: torch
    door: {fileID: 0}
    puzzle: {fileID: 0}
    exit: {fileID: 0}
    hint: "\u0421\u0442\u043E\u043B \u0443\u0431\u043E\u0440\u0449\u0438\u043A\u0430
      \u2014 \u043F\u0440\u044F\u043C\u043E \u0437\u0434\u0435\u0441\u044C, \u0432
      \u043A\u0430\u043C\u043E\u0440\u043A\u0435, \u0433\u0434\u0435 \u0432\u0441\u0451
      \u043D\u0430\u0447\u0430\u043B\u043E\u0441\u044C."
  - id: office_code
    description: "\u041F\u043E\u043F\u0430\u0434\u0438 \u0432 \u043A\u0430\u0431\u0438\u043D\u0435\u0442
      \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438. \u041A\u043E\u0434
      \u043E\u0442 \u0434\u0432\u0435\u0440\u0438 \u2014 \u043D\u0430 \u0442\u0440\u0451\u0445
      \u0437\u0430\u043F\u0438\u0441\u043A\u0430\u0445: \u043D\u0430 \u0441\u043A\u043B\u0430\u0434\u0435,
      \u0432 \u0441\u0431\u043E\u0440\u043E\u0447\u043D\u043E\u043C \u0446\u0435\u0445\u0435
      \u0438 \u0432 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438."
    condition: 2
    keyId: 
    door: {fileID: 2087802044}
    puzzle: {fileID: 0}
    exit: {fileID: 0}
    hint: "\u0417\u0430\u043F\u0438\u0441\u043A\u0438 \u0432\u0438\u0441\u044F\u0442
      \u043D\u0430 \u0441\u0442\u0435\u043D\u0430\u0445 \u0441\u043A\u043B\u0430\u0434\u0430,
      \u0441\u0431\u043E\u0440\u043E\u0447\u043D\u043E\u0433\u043E \u0446\u0435\u0445\u0430
      \u0438 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438 \u0438
      \u0441\u043B\u0435\u0433\u043A\u0430 \u0441\u0432\u0435\u0442\u044F\u0442\u0441\u044F.
      \u041D\u0430\u0439\u0434\u0435\u043D\u043D\u044B\u0435 \u0446\u0438\u0444\u0440\u044B
      \u2014 \u0432 \u0434\u043D\u0435\u0432\u043D\u0438\u043A\u0435 (J)."
  - id: keycard
    description: "\u0412\u043E\u0437\u044C\u043C\u0438 \u043A\u043B\u044E\u0447-\u043A\u0430\u0440\u0442\u0443
      \u043E\u0445\u0440\u0430\u043D\u044B \u0432 \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0435
      \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438."
    condition: 1
    keyId: keycard
    door: {fileID: 0}
    puzzle: {fileID: 0}
    exit: {fileID: 0}
    hint: "\u041A\u043B\u044E\u0447-\u043A\u0430\u0440\u0442\u0430 \u043B\u0435\u0436\u0438\u0442
      \u043D\u0430 \u0441\u0442\u043E\u043B\u0435 \u0432 \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0435
      \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438, \u0443
      \u0441\u0435\u0432\u0435\u0440\u043D\u043E\u0439 \u0441\u0442\u0435\u043D\u044B."
  - id: breaker_room
    description: "\u041F\u043E\u0434\u043D\u0438\u043C\u0438\u0441\u044C \u043F\u043E
      \u043C\u043E\u0441\u0442\u043A\u0430\u043C \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u0446\u0435\u0445\u0430
      \u043A \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u0449\u0438\u0442\u043E\u0432\u043E\u0439."
    condition: 2
    keyId: 
    door: {fileID: 1912055647}
    puzzle: {fileID: 0}
    exit: {fileID: 0}
    hint: "\u041C\u043E\u0441\u0442\u043A\u0438 \u0432 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u0446\u0435\u0445\u0435
      \u0432\u0435\u0434\u0443\u0442 \u043A \u0434\u0432\u0435\u0440\u0438 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u0449\u0438\u0442\u043E\u0432\u043E\u0439
      \u2014 \u043E\u043D\u0430 \u0432\u044B\u0441\u043E\u043A\u043E \u0443 \u0432\u043E\u0441\u0442\u043E\u0447\u043D\u043E\u0439
      \u0441\u0442\u0435\u043D\u044B."
  - id: breakers
    description: "\u0412\u043A\u043B\u044E\u0447\u0438 \u0440\u0443\u0431\u0438\u043B\u044C\u043D\u0438\u043A\u0438
      \u043D\u0430 \u0433\u043B\u0430\u0432\u043D\u043E\u043C \u0449\u0438\u0442\u0435."
    condition: 3
    keyId: 
    door: {fileID: 0}
    puzzle: {fileID: 1981057909}
    exit: {fileID: 0}
    hint: "\u0412\u0441\u0435 \u0440\u0443\u0431\u0438\u043B\u044C\u043D\u0438\u043A\u0438
      \u043D\u0430 \u0449\u0438\u0442\u0435 \u0434\u043E\u043B\u0436\u043D\u044B
      \u0441\u0442\u043E\u044F\u0442\u044C \u0432\u0432\u0435\u0440\u0445\u0443."
  - id: fuel
    description: "\u041F\u0440\u0438\u043D\u0435\u0441\u0438 \u0434\u0432\u0435 \u043A\u0430\u043D\u0438\u0441\u0442\u0440\u044B
      \u0442\u043E\u043F\u043B\u0438\u0432\u0430 \u0434\u043B\u044F \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440\u0430.
      \u041E\u043D\u0438 \u043D\u0430 \u0441\u043A\u043B\u0430\u0434\u0435."
    condition: 5
    keyId: fuel_1,fuel_2
    door: {fileID: 0}
    puzzle: {fileID: 0}
    exit: {fileID: 0}
    hint: "\u041A\u0430\u043D\u0438\u0441\u0442\u0440\u044B \u0441\u0442\u043E\u044F\u0442
      \u043D\u0430 \u0441\u043A\u043B\u0430\u0434\u0435, \u043D\u0430 \u043F\u043E\u043B\u0443
      \u0443 \u0441\u0442\u0435\u043D."
  - id: generator
    description: "\u0417\u0430\u043F\u0443\u0441\u0442\u0438 \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440
      \u043D\u0430 \u043D\u0438\u0436\u043D\u0435\u043C \u044D\u0442\u0430\u0436\u0435
      \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u0446\u0435\u0445\u0430."
    condition: 3
    keyId: 
    door: {fileID: 0}
    puzzle: {fileID: 92782016}
    exit: {fileID: 0}
    hint: "\u0413\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440 \u2014 \u043D\u0430
      \u043D\u0438\u0436\u043D\u0435\u043C \u044D\u0442\u0430\u0436\u0435 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u0446\u0435\u0445\u0430,
      \u043F\u0443\u0441\u043A\u043E\u0432\u043E\u0439 \u043F\u0443\u043B\u044C\u0442
      \u0443 \u0435\u0433\u043E \u0432\u043E\u0441\u0442\u043E\u0447\u043D\u043E\u0433\u043E
      \u043A\u0440\u0430\u044F."
  - id: valves
    description: "\u041E\u0442\u043A\u0440\u043E\u0439 \u0432\u0435\u043D\u0442\u0438\u043B\u0438
      \u0433\u0438\u0434\u0440\u0430\u0432\u043B\u0438\u043A\u0438 \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0435
      \u043F\u043E\u0434 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u0449\u0438\u0442\u043E\u0432\u043E\u0439.
      \u041F\u043E\u0440\u044F\u0434\u043E\u043A \u2014 \u043D\u0430 \u0436\u0451\u043B\u0442\u043E\u0439
      \u0434\u043E\u0441\u043A\u0435."
    condition: 3
    keyId: 
    door: {fileID: 0}
    puzzle: {fileID: 1229159983}
    exit: {fileID: 0}
    hint: "\u041A\u043E\u043C\u043D\u0430\u0442\u0430 \u0432\u0435\u043D\u0442\u0438\u043B\u0435\u0439
      \u2014 \u043F\u043E\u0434 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u0449\u0438\u0442\u043E\u0432\u043E\u0439,
      \u0434\u0432\u0435\u0440\u0438 \u0441 \u0437\u0430\u043F\u0430\u0434\u043D\u043E\u0439
      \u0438 \u044E\u0436\u043D\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B.
      \u041F\u043E\u0440\u044F\u0434\u043E\u043A \u043D\u0430\u043F\u0438\u0441\u0430\u043D
      \u043D\u0430 \u0436\u0451\u043B\u0442\u043E\u0439 \u0434\u043E\u0441\u043A\u0435
      \u0432\u043D\u0443\u0442\u0440\u0438 \u0438 \u0437\u0430\u043F\u0438\u0441\u0430\u043D
      \u0432 \u0434\u043D\u0435\u0432\u043D\u0438\u043A\u0435 (J)."
  - id: escape
    description: "\u041F\u043E\u0434\u043D\u0438\u043C\u0438 \u0432\u043E\u0440\u043E\u0442\u0430
      \u043F\u043E\u0433\u0440\u0443\u0437\u043E\u0447\u043D\u043E\u0439 \u0437\u043E\u043D\u044B
      \u0432 \u0441\u0431\u043E\u0440\u043E\u0447\u043D\u043E\u043C \u0446\u0435\u0445\u0435
      \u0438 \u043F\u0440\u043E\u0434\u0435\u0440\u0436\u0438\u0441\u044C, \u043F\u043E\u043A\u0430
      \u043E\u043D\u0438 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F."
    condition: 4
    keyId: 
    door: {fileID: 0}
    puzzle: {fileID: 0}
    exit: {fileID: 389044839}
    hint: "\u0412\u043E\u0440\u043E\u0442\u0430 \u2014 \u043D\u0430 \u0432\u043E\u0441\u0442\u043E\u0447\u043D\u043E\u0439
      \u0441\u0442\u0435\u043D\u0435 \u0441\u0431\u043E\u0440\u043E\u0447\u043D\u043E\u0433\u043E
      \u0446\u0435\u0445\u0430. \u041F\u043E\u043A\u0430 \u043E\u043D\u0438 \u043F\u043E\u043B\u0437\u0443\u0442
      \u0432\u0432\u0435\u0440\u0445, \u043F\u0440\u044F\u0447\u044C\u0441\u044F,
      \u0441\u043B\u0435\u043F\u0438 \u0435\u0433\u043E \u0432\u0441\u043F\u044B\u0448\u043A\u043E\u0439,
      \u043E\u0442\u0432\u043B\u0435\u043A\u0430\u0439 \u0431\u0440\u043E\u0441\u043A\u0430\u043C\u0438
      \u2014 \u0433\u043B\u0430\u0432\u043D\u043E\u0435, \u0432\u044B\u0436\u0438\u0432\u0438."
  keyHolder: {fileID: 2042624951}
  allCompleteDescription: "\u0422\u044B \u043D\u0430 \u0441\u0432\u043E\u0431\u043E\u0434\u0435."
  logChanges: 1
