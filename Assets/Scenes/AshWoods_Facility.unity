  prompt: "\u0421\u0442\u0440\u0430\u0432\u0438\u0442\u044C \u043F\u0430\u0440 (\u0433\u0440\u043E\u043C\u043A\u043E
    \u2014 \u043F\u0440\u0438\u043C\u0430\u043D\u0438\u0442 \u0435\u0433\u043E \u0441\u044E\u0434\u0430)"
  armedMessage: "\u0414\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0440\u0430\u0441\u0442\u0451\u0442.
    \u041E\u0442\u043E\u0439\u0434\u0438 \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u0435
    \u2014 \u043E\u043D\u043E \u044D\u0442\u043E \u0443\u0441\u043B\u044B\u0448\u0438\u0442.
    \u042D\u0442\u043E \u043B\u0438\u0448\u044C \u043E\u0442\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u0435,
    \u043A \u0432\u044B\u0445\u043E\u0434\u0443 \u043D\u0435 \u0432\u0435\u0434\u0451\u0442."
  busyPrompt: "\u0421\u0431\u0440\u043E\u0441 \u043F\u0430\u0440\u0430 (\u0441\u0442\u0440\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F)"
  rechargePrompt: "\u0421\u0431\u0440\u043E\u0441 \u043F\u0430\u0440\u0430 (\u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435
    \u0435\u0449\u0451 \u043D\u0435 \u043D\u0430\u0431\u0440\u0430\u043B\u043E\u0441\u044C)"
  spentPrompt: "\u0421\u0431\u0440\u043E\u0441 \u043F\u0430\u0440\u0430 (\u043F\u0443\u0441\u0442\u043E)"
  delaySeconds: 3
