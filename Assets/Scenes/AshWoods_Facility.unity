  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AshenWoods.Interaction.InfoPoint
  prompt: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C \u0437\u0430\u043F\u0438\u0441\u043A\u0443"
  message: "\u041F\u0438\u0442,\n\n\u0421\u0420\u0415\u0414\u041D\u042F\u042F \u0446\u0438\u0444\u0440\u0430
    \u043D\u043E\u0432\u043E\u0433\u043E \u043A\u043E\u0434\u0430 \u043E\u0442 \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0430:\n\n       
    <b>{code2}</b>\n\n\u0426\u0435\u043B\u0438\u043A\u043E\u043C \u043D\u0438\u0433\u0434\u0435
    \u043D\u0435 \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0439 \u2014 \u043E\u043D\u0430
    \u043D\u0430\u043C \u0433\u043E\u043B\u043E\u0432\u044B \u043E\u0442\u043E\u0440\u0432\u0451\u0442.\n\n\u2014
    \u0420."
  showAsSheet: 1
  sheetTitle: "\u0421\u0411\u041E\u0420\u041E\u0427\u041D\u042B\u0419 \u0426\u0415\u0425"
  showMap: 0
  markEnemies: 0
  useNoise: 0
  journalLine: "\u041A\u043E\u0434 \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0430,
    \u0441\u0440\u0435\u0434\u043D\u044F\u044F \u0446\u0438\u0444\u0440\u0430: <b>{code2}</b>
    (\u0441\u0431\u043E\u0440\u043E\u0447\u043D\u044B\u0439 \u0446\u0435\u0445)"
  loreId: 
  needsPower: 0
  unpoweredPrompt: "\u041D\u043E\u0443\u0442\u0431\u0443\u043A (\u043D\u0435\u0442
    \u043F\u0438\u0442\u0430\u043D\u0438\u044F)"
  unpoweredMessage: "\u041D\u0435 \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F.
    \u0412\u043E \u0432\u0441\u0451\u043C \u0437\u0434\u0430\u043D\u0438\u0438 \u043D\u0435\u0442
    \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u0430."
