  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8559d1e585ee54143b906361e7f3790b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AshenWoods.Interaction.InfoPoint
  prompt: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C \u0436\u0443\u0440\u043D\u0430\u043B"
  message: "\u0425\u0435\u0439\u043B \u0432\u0435\u043B\u0435\u043B\u0430 \u0441\u043B\u0438\u0442\u044C
    \u0442\u043E\u043F\u043B\u0438\u0432\u043E \u0438\u0437 \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440\u0430
    \u0438 \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043A\u0430\u043D\u0438\u0441\u0442\u0440\u044B
    \u043D\u0430 \u0441\u043A\u043B\u0430\u0434\u0435. \xAB\u041F\u043E\u043A\u0430
    \u043D\u0435\u0442 \u043F\u0438\u0442\u0430\u043D\u0438\u044F, \u0432\u043E\u0440\u043E\u0442\u0430
    \u043D\u0435 \u043F\u043E\u0434\u043D\u0438\u043C\u0443\u0442\u0441\u044F\xBB.\n\n\u041E\u043D\u0430
    \u043D\u0435 \u0432\u043E\u0440\u043E\u0432 \u0431\u043E\u0438\u0442\u0441\u044F.
    \u041E\u043D\u0430 \u0445\u043E\u0447\u0435\u0442 \u0447\u0442\u043E-\u0442\u043E
    \u0443\u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0412\u041D\u0423\u0422\u0420\u0418."
  showAsSheet: 1
  sheetTitle: "\u0416\u0423\u0420\u041D\u0410\u041B \u042D\u041B\u0415\u041A\u0422\u0420\u0418\u041A\u0410"
  showMap: 0
  markEnemies: 0
  useNoise: 0
  journalLine: 
  loreId: log_electric
  needsPower: 0
  unpoweredPrompt: "\u041D\u043E\u0443\u0442\u0431\u0443\u043A (\u043D\u0435\u0442
    \u043F\u0438\u0442\u0430\u043D\u0438\u044F)"
  unpoweredMessage: "\u041D\u0435 \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F.
    \u0412\u043E \u0432\u0441\u0451\u043C \u0437\u0434\u0430\u043D\u0438\u0438 \u043D\u0435\u0442
    \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u0430."
