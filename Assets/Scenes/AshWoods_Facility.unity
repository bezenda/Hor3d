--- !u!114 &1429198013
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1429198010}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8559d1e585ee54143b906361e7f3790b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AshenWoods.Interaction.InfoPoint
  prompt: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C \u0437\u0430\u043F\u0438\u0441\u043A\u0443"
  message: "\u0425\u0435\u0439\u043B \u041E\u041F\u042F\u0422\u042C \u0441\u043C\u0435\u043D\u0438\u043B\u0430
    \u043A\u043E\u0434 \u043D\u0430 \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0435.\n\n\u042F
    \u0443\u0441\u043F\u0435\u043B \u0440\u0430\u0437\u0433\u043B\u044F\u0434\u0435\u0442\u044C
    \u0442\u043E\u043B\u044C\u043A\u043E \u041F\u0415\u0420\u0412\u0423\u042E \u0446\u0438\u0444\u0440\u0443,
    \u043F\u043E\u043A\u0430 \u043E\u043D\u0430 \u043D\u0435 \u0437\u0430\u0445\u043B\u043E\u043F\u043D\u0443\u043B\u0430
    \u0434\u0432\u0435\u0440\u044C:\n\n        <b>{code1}</b>\n\n\u041E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435
    \u0441\u043F\u0440\u043E\u0441\u0438 \u0443 \u041F\u0438\u0442\u0430 \u0438\u0437
    \u0441\u0431\u043E\u0440\u043E\u0447\u043D\u043E\u0433\u043E.\n\n\u2014 \u041C."
  showAsSheet: 1
  sheetTitle: "\u0421\u041A\u041B\u0410\u0414 \u2014 \u041D\u041E\u0427\u041D\u0410\u042F
    \u0421\u041C\u0415\u041D\u0410"
  showMap: 0
  markEnemies: 0
  useNoise: 0
  journalLine: "\u041A\u043E\u0434 \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0430,
    \u043F\u0435\u0440\u0432\u0430\u044F \u0446\u0438\u0444\u0440\u0430: <b>{code1}</b>
    (\u0441\u043A\u043B\u0430\u0434)"
  loreId: 
  needsPower: 0
  unpoweredPrompt: "\u041D\u043E\u0443\u0442\u0431\u0443\u043A (\u043D\u0435\u0442
    \u043F\u0438\u0442\u0430\u043D\u0438\u044F)"
  unpoweredMessage: "\u041D\u0435 \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F.
    \u0412\u043E \u0432\u0441\u0451\u043C \u0437\u0434\u0430\u043D\u0438\u0438 \u043D\u0435\u0442
    \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u0430."
