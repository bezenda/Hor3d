  prerequisitePrompt: "\u041D\u0435\u0442 \u043F\u0438\u0442\u0430\u043D\u0438\u044F"
  prerequisiteMessage: "\u041D\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442:
    \u0446\u0435\u043F\u044C \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F
    \u043E\u0431\u0435\u0441\u0442\u043E\u0447\u0435\u043D\u0430."
  ordered: 0
  shuffleOrder: 1
  orderToken: 
  wrongOrderMessage: "\u041D\u0435 \u0442\u043E\u0442 \u0432\u0435\u043D\u0442\u0438\u043B\u044C.
    \u0414\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043F\u0430\u0434\u0430\u0435\u0442
    \u0441 \u0433\u0440\u043E\u0445\u043E\u0442\u043E\u043C \u2014 \u043D\u0430\u0447\u0438\u043D\u0430\u0439
    \u0437\u0430\u043D\u043E\u0432\u043E."
  wrongOrderNoise: 0.6
  solvedMessage: "\u0429\u0438\u0442 \u043E\u0436\u0438\u043B, \u043D\u043E \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439
    \u0441\u0432\u0435\u0442 \u0442\u0430\u043A \u0438 \u043D\u0435 \u0437\u0430\u0433\u043E\u0440\u0435\u043B\u0441\u044F.
    \u041F\u043E\u0445\u043E\u0436\u0435, \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440
    \u0431\u0435\u0437 \u0442\u043E\u043F\u043B\u0438\u0432\u0430."
  lockedPrompt: "\u041F\u0440\u0438\u0432\u0438\u043D\u0447\u0435\u043D\u043E \u043D\u0430\u043C\u0435\u0440\u0442\u0432\u043E
    (\u043D\u0443\u0436\u0435\u043D \u043B\u043E\u043C)"
  lockedMessage: "\u041F\u0430\u043D\u0435\u043B\u044C \u043F\u0440\u0438\u0432\u0438\u043D\u0447\u0435\u043D\u0430
