--- !u!114 &1004350711
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1004350709}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8559d1e585ee54143b906361e7f3790b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AshenWoods.Interaction.InfoPoint
  prompt: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C \u0437\u0430\u043F\u0438\u0441\u043A\u0443"
  message: "\u0415\u0441\u043B\u0438 \u0442\u044B \u044D\u0442\u043E \u0447\u0438\u0442\u0430\u0435\u0448\u044C,
    \u0437\u043D\u0430\u0447\u0438\u0442, \u044F \u0442\u0430\u043A \u0438 \u043D\u0435
    \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F. \u041F\u043E\u0448\u0451\u043B
    \u0438\u0441\u043A\u0430\u0442\u044C \u0420\u043E\u0441\u0441\u0430.\n\n\u0424\u043E\u043D\u0430\u0440\u044C
    \u043E\u0441\u0442\u0430\u0432\u0438\u043B \u043D\u0430 \u0441\u0442\u043E\u043B\u0435.
    \u0411\u0430\u0442\u0430\u0440\u0435\u0439\u043A\u0438 \u0432\u0430\u043B\u044F\u044E\u0442\u0441\u044F
    \u043F\u043E \u0432\u0441\u0435\u0439 \u0441\u0442\u0430\u043D\u0446\u0438\u0438
    \u2014 \u043F\u043E\u0434\u0431\u0438\u0440\u0430\u0439 \u0432\u0441\u0435.\n\n\u041D\u043E\u0443\u0442\u0431\u0443\u043A
    \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u043E\u0442 \u0430\u043A\u043A\u0443\u043C\u0443\u043B\u044F\u0442\u043E\u0440\u0430.
    \u041E\u0445\u0440\u0430\u043D\u0430 \u0440\u0430\u0437\u043E\u0441\u043B\u0430\u043B\u0430
    \u043F\u043E \u043D\u0435\u043C\u0443 \u043F\u0430\u043C\u044F\u0442\u043A\u0443
    \u2014 \u043F\u0440\u043E\u0447\u0442\u0438, \u0442\u0430\u043C \u0432\u0441\u0451.\n\n\u0418
    \u043D\u0435 \u0431\u0435\u0433\u0438. \u041E\u043D\u043E \u0441\u043B\u044B\u0448\u0438\u0442.\n\n\u2014
    \u0413."
  showAsSheet: 1
  sheetTitle: "\u0414\u041B\u042F \u0421\u041C\u0415\u041D\u0429\u0418\u041A\u0410"
  showMap: 0
  markEnemies: 0
  useNoise: 0
  journalLine: "\u0423\u0431\u043E\u0440\u0449\u0438\u043A: \u0432 \u043D\u043E\u0443\u0442\u0431\u0443\u043A\u0435
    \u043D\u0430 \u0441\u0442\u043E\u043B\u0435 \u043F\u0430\u043C\u044F\u0442\u043A\u0430
    \u043E\u0445\u0440\u0430\u043D\u044B. \u041D\u0435 \u0431\u0435\u0433\u0430\u0442\u044C."
  loreId: 
  needsPower: 0
  unpoweredPrompt: "\u041D\u043E\u0443\u0442\u0431\u0443\u043A (\u043D\u0435\u0442
