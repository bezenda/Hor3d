  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AshenWoods.Interaction.InfoPoint
  prompt: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C \u0436\u0443\u0440\u043D\u0430\u043B"
  message: "\u0418\u0437\u043E\u043B\u0438\u0440\u0443\u044E\u0449\u0438\u0439 \u0433\u0435\u043B\u044C
    \u2014 40 \u0431\u043E\u0447\u0435\u043A. \u0421\u0435\u0434\u0430\u0442\u0438\u0432\u043D\u043E\u0435
    (\u0432\u0435\u0442\u0435\u0440\u0438\u043D\u0430\u0440\u043D\u043E\u0435) \u2014
    12 \u044F\u0449\u0438\u043A\u043E\u0432. \u0421\u044B\u0440\u043E\u0435 \u043C\u044F\u0441\u043E
    \u2014 200 \u043A\u0433 \u0435\u0436\u0435\u043D\u0435\u0434\u0435\u043B\u044C\u043D\u043E.\n\n\u041F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B\u044C:
    \u0434-\u0440 \u042D. \u0425\u0435\u0439\u043B. \u041D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435:
    B-7.\n\n\u0427\u0442\u043E \u0441\u044A\u0435\u0434\u0430\u0435\u0442 200 \u043A\u0433
    \u0432 \u043D\u0435\u0434\u0435\u043B\u044E?"
  showAsSheet: 1
  sheetTitle: "\u0421\u041A\u041B\u0410\u0414 \u2014 \u041D\u0410\u041A\u041B\u0410\u0414\u041D\u0410\u042F
