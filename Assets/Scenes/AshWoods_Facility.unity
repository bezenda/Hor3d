--- !u!114 &477311782
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 477311780}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8559d1e585ee54143b906361e7f3790b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AshenWoods.Interaction.InfoPoint
  prompt: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C \u0436\u0443\u0440\u043D\u0430\u043B"
  message: "\u041D\u0430\u0439\u0434\u0435\u043D \u0432 Ashen Woods, \u043A \u044E\u0433\u0443
    \u043E\u0442 \u0441\u0442\u0430\u0440\u043E\u0433\u043E \u043A\u0430\u0440\u044C\u0435\u0440\u0430.\n\n\u042F\u0440\u043A\u0438\u0439
    \u0441\u0432\u0435\u0442 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0442
    \u043A\u0440\u0430\u0439\u043D\u0435 \u043F\u043B\u043E\u0445\u043E \u2014 \u0444\u043E\u0442\u043E\u0432\u0441\u043F\u044B\u0448\u043A\u0430
    \u0432\u0430\u043B\u0438\u0442 \u0435\u0433\u043E \u0441 \u043D\u043E\u0433 \u043D\u0430
    \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u0435\u043A\u0443\u043D\u0434.
    \u0421\u043B\u0443\u0445 \u043D\u0430\u043C\u043D\u043E\u0433\u043E \u043E\u0441\u0442\u0440\u0435\u0435
    \u0432\u0441\u0435\u0433\u043E, \u0447\u0442\u043E \u043C\u044B \u043A\u043E\u0433\u0434\u0430-\u043B\u0438\u0431\u043E
    \u0438\u0437\u043C\u0435\u0440\u044F\u043B\u0438.\n\n\u041E\u043D \u043D\u0430\u0447\u0430\u043B
    \u043F\u043E\u0434\u0440\u0430\u0436\u0430\u0442\u044C \u0433\u043E\u043B\u043E\u0441\u0430\u043C
    \u043D\u043E\u0447\u043D\u043E\u0439 \u0441\u043C\u0435\u043D\u044B."
  showAsSheet: 1
  sheetTitle: "\u0416\u0423\u0420\u041D\u0410\u041B \u0418\u0421\u0421\u041B\u0415\u0414\u041E\u0412\u0410\u041D\u0418\u0419
    \u2014 B-7, \u0414\u0415\u041D\u042C 31"
  showMap: 0
  markEnemies: 0
  useNoise: 0
  journalLine: 
  loreId: log_research1
  needsPower: 0
  unpoweredPrompt: "\u041D\u043E\u0443\u0442\u0431\u0443\u043A (\u043D\u0435\u0442
    \u043F\u0438\u0442\u0430\u043D\u0438\u044F)"
  unpoweredMessage: "\u041D\u0435 \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F.
    \u0412\u043E \u0432\u0441\u0451\u043C \u0437\u0434\u0430\u043D\u0438\u0438 \u043D\u0435\u0442
    \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u0430."
  screen: {fileID: 0}
  screenOff: {fileID: 0}
  screenOn: {fileID: 0}
  poweredMessage: 
  showControls: 0
