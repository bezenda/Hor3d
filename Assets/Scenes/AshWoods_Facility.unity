  switchesRequired: 0
  requiredItemId: 
  consumeItems: 0
  prerequisite: {fileID: 92782016}
  prerequisitePrompt: "\u0412\u0435\u043D\u0442\u0438\u043B\u044C (\u0443 \u043D\u0430\u0441\u043E\u0441\u043E\u0432
    \u043D\u0435\u0442 \u043F\u0438\u0442\u0430\u043D\u0438\u044F)"
  prerequisiteMessage: "\u041A\u0440\u0443\u0442\u0438\u0442\u0441\u044F \u0432\u0445\u043E\u043B\u043E\u0441\u0442\u0443\u044E.
    \u0423 \u043D\u0430\u0441\u043E\u0441\u043E\u0432 \u0435\u0449\u0451 \u043D\u0435\u0442
    \u043F\u0438\u0442\u0430\u043D\u0438\u044F."
  ordered: 1
  shuffleOrder: 1
  orderToken: valves
  wrongOrderMessage: "\u041D\u0435 \u0442\u043E\u0442 \u0432\u0435\u043D\u0442\u0438\u043B\u044C.
    \u0414\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043F\u0430\u0434\u0430\u0435\u0442
    \u0441 \u0433\u0440\u043E\u0445\u043E\u0442\u043E\u043C \u2014 \u043D\u0430\u0447\u0438\u043D\u0430\u0439
    \u0437\u0430\u043D\u043E\u0432\u043E."
  wrongOrderNoise: 0.6
  solvedMessage: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0432\u0435\u043D\u0442\u0438\u043B\u044C
    \u043E\u0442\u043A\u0440\u044B\u0442. \u0422\u0440\u0443\u0431\u044B \u0433\u0440\u043E\u0445\u043E\u0447\u0443\u0442
    \u0434\u043E \u0441\u0430\u043C\u043E\u0439 \u043F\u043E\u0433\u0440\u0443\u0437\u043E\u0447\u043D\u043E\u0439
    \u0437\u043E\u043D\u044B \u2014 \u0432 \u0433\u0438\u0434\u0440\u0430\u0432\u043B\u0438\u043A\u0435
    \u043F\u043E\u044F\u0432\u0438\u043B\u043E\u0441\u044C \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435."
  lockedPrompt: "\u041F\u0440\u0438\u0432\u0438\u043D\u0447\u0435\u043D\u043E \u043D\u0430\u043C\u0435\u0440\u0442\u0432\u043E
    (\u043D\u0443\u0436\u0435\u043D \u043B\u043E\u043C)"
  lockedMessage: "\u041F\u0430\u043D\u0435\u043B\u044C \u043F\u0440\u0438\u0432\u0438\u043D\u0447\u0435\u043D\u0430
    \u043D\u0430\u043C\u0435\u0440\u0442\u0432\u043E. \u041D\u0443\u0436\u0435\u043D
    \u043B\u043E\u043C."
  solveNoiseLoudness: 0.7
  logChanges: 1
