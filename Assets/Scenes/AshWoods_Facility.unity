  lockedPrompt: "\u0412\u043E\u0440\u043E\u0442\u0430 \u043F\u043E\u0433\u0440\u0443\u0437\u043E\u0447\u043D\u043E\u0439
    \u0437\u043E\u043D\u044B"
  lockedMessage: "\u041F\u0443\u043B\u044C\u0442 \u043C\u0451\u0440\u0442\u0432 \u2014
    \u0432\u043E\u0440\u043E\u0442\u0430\u043C \u043D\u0443\u0436\u043D\u043E \u043F\u0438\u0442\u0430\u043D\u0438\u0435."
  openPrompt: "\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u0432\u043E\u0440\u043E\u0442\u0430
    \u043F\u043E\u0433\u0440\u0443\u0437\u043E\u0447\u043D\u043E\u0439 \u0437\u043E\u043D\u044B"
  escapedMessage: "\u0412\u043E\u0440\u043E\u0442\u0430 \u0441\u043E \u0441\u043A\u0440\u0435\u0436\u0435\u0442\u043E\u043C
    \u0443\u0445\u043E\u0434\u044F\u0442 \u0432\u0432\u0435\u0440\u0445, \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0443.
    \u0425\u043E\u043B\u043E\u0434\u043D\u044B\u0439 \u0432\u043E\u0437\u0434\u0443\u0445.
    \u0422\u044B \u0431\u0435\u0436\u0438\u0448\u044C."
  openDelaySeconds: 50
  rollingDoor: {fileID: 557656603}
  rollingDoorRise: 4.4
  openingPrompt: "\u0412\u043E\u0440\u043E\u0442\u0430 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044E\u0442\u0441\u044F\u2026"
  openingStartedMessage: "\u0412\u043E\u0440\u043E\u0442\u0430 \u0432\u0437\u0434\u0440\u0430\u0433\u0438\u0432\u0430\u044E\u0442
    \u0438 \u0441\u043E \u0441\u043A\u0440\u0435\u0436\u0435\u0442\u043E\u043C \u043F\u043E\u043B\u0437\u0443\u0442
    \u0432\u0432\u0435\u0440\u0445. \u042D\u0442\u043E \u0433\u0440\u043E\u043C\u043A\u043E.
    \u041F\u0440\u043E\u0434\u0435\u0440\u0436\u0438\u0441\u044C."
  gateReadyPrompt: "\u0411\u0435\u0436\u0430\u0442\u044C \u043D\u0430\u0440\u0443\u0436\u0443"
  escapeNoiseLoudness: 0.9
  extraRequirement: {fileID: 1229159983}
  extraLockedPrompt: "\u0412\u043E\u0440\u043E\u0442\u0430 (\u043D\u0435\u0442 \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F
    \u0432 \u0433\u0438\u0434\u0440\u0430\u0432\u043B\u0438\u043A\u0435)"
  extraLockedMessage: "\u041C\u043E\u0442\u043E\u0440 \u0432\u043E\u0435\u0442, \u043D\u043E
    \u0432\u043E\u0440\u043E\u0442\u0430 \u043D\u0435 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044E\u0442\u0441\u044F.
    \u0412 \u0433\u0438\u0434\u0440\u0430\u0432\u043B\u0438\u043A\u0435 \u043D\u0435\u0442
    \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F."
