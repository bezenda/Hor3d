  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8559d1e585ee54143b906361e7f3790b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AshenWoods.Interaction.InfoPoint
  prompt: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0442\u0435\u0440\u043C\u0438\u043D\u0430\u043B"
  message: "B-7, \u041D\u0415\u0414\u0415\u041B\u042F 31: \u043E\u0431\u044A\u0435\u043A\u0442
    \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0440\u0435\u0430\u0433\u0438\u0440\u0443\u0435\u0442
    \u043D\u0430 \u0441\u0435\u0434\u0430\u0442\u0438\u0432\u043D\u044B\u0435 \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442\u044B.
    \u0410\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043D\u043E \u0440\u0435\u0430\u0433\u0438\u0440\u0443\u0435\u0442
    \u043D\u0430 \u0448\u0443\u043C. \u0421\u0438\u043B\u044C\u043D\u0430\u044F \u0432\u0441\u043F\u044B\u0448\u043A\u0430
    \u043E\u0433\u043B\u0443\u0448\u0430\u0435\u0442 \u0435\u0433\u043E \u043D\u0430
    \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u0435\u043A\u0443\u043D\u0434
    \u2014 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u043D\u0430\u0434\u0451\u0436\u043D\u044B\u0439 \u0441\u043F\u043E\u0441\u043E\u0431
    \u043F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E. \u0414\u0432\u0435\u0440\u0438
    \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438 \u0434\u0435\u0440\u0436\u0430\u0442\u044C
    \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u043C\u0438."
  showAsSheet: 0
  sheetTitle: "\u0421\u0425\u0415\u041C\u0410 \u0421\u0422\u0410\u041D\u0426\u0418\u0418"
  showMap: 1
  markEnemies: 0
  useNoise: 0
  journalLine: 
  loreId: 
  needsPower: 0
  unpoweredPrompt: "\u041D\u043E\u0443\u0442\u0431\u0443\u043A (\u043D\u0435\u0442
    \u043F\u0438\u0442\u0430\u043D\u0438\u044F)"
  unpoweredMessage: "\u041D\u0435 \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F.
    \u0412\u043E \u0432\u0441\u0451\u043C \u0437\u0434\u0430\u043D\u0438\u0438 \u043D\u0435\u0442
    \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u0430."
