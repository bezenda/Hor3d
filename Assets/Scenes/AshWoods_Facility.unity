  m_Script: {fileID: 11500000, guid: 8559d1e585ee54143b906361e7f3790b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AshenWoods.Interaction.InfoPoint
  prompt: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C \u0437\u0430\u043F\u0438\u0441\u043A\u0443"
  message: "\u041A\u0430\u0431\u0438\u043D\u0435\u0442, \u043A\u043E\u0434\u043E\u0432\u044B\u0439
    \u0437\u0430\u043C\u043E\u043A, \u041F\u041E\u0421\u041B\u0415\u0414\u041D\u042F\u042F
    \u0446\u0438\u0444\u0440\u0430: <b>{code3}</b>\n(\u043F\u0435\u0440\u0432\u044B\u0435
    \u0434\u0432\u0435 \u2014 \u0441\u043F\u0440\u043E\u0441\u0438 \u043D\u0430 \u0441\u043A\u043B\u0430\u0434\u0435
    \u0438 \u0432 \u0441\u0431\u043E\u0440\u043E\u0447\u043D\u043E\u043C)\n\nB-7
    \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043E\u043F\u044F\u0442\u044C \u0441\u043A\u0440\u0451\u0431\u0441\u044F
    \u0432 \u0441\u0442\u0435\u043A\u043B\u043E. \u0422\u0440\u0435\u0442\u0438\u0439
    \u0440\u0430\u0437 \u0437\u0430 \u043D\u0435\u0434\u0435\u043B\u044E.\n\u041A\u043E\u0433\u0434\u0430
    \u0433\u043E\u0440\u0438\u0442 \u0441\u0432\u0435\u0442, \u043E\u043D \u0437\u0430\u0442\u0438\u0445\u0430\u0435\u0442."
  showAsSheet: 1
  sheetTitle: "\u041B\u0410\u0411\u041E\u0420\u0410\u0422\u041E\u0420\u0418\u042F
    \u2014 \u041A\u0420\u042B\u041B\u041E B"
  showMap: 0
  markEnemies: 0
  useNoise: 0
  journalLine: "\u041A\u043E\u0434 \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0430,
    \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u0446\u0438\u0444\u0440\u0430:
    <b>{code3}</b> (\u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044F)"
  loreId: 
  needsPower: 0
  unpoweredPrompt: "\u041D\u043E\u0443\u0442\u0431\u0443\u043A (\u043D\u0435\u0442
    \u043F\u0438\u0442\u0430\u043D\u0438\u044F)"
  unpoweredMessage: "\u041D\u0435 \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F.
    \u0412\u043E \u0432\u0441\u0451\u043C \u0437\u0434\u0430\u043D\u0438\u0438 \u043D\u0435\u0442
    \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u0430."
