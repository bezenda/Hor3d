  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AshenWoods.Interaction.InfoPoint
  prompt: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C \u0436\u0443\u0440\u043D\u0430\u043B"
  message: "\u0422\u043E\u043C\u0443, \u043A\u0442\u043E \u044D\u0442\u043E \u0447\u0438\u0442\u0430\u0435\u0442:\n\n\u0432
    \u0432\u0435\u043D\u0442\u0438\u043B\u044F\u0446\u0438\u0438 \u043D\u0430\u0434
    \u0441\u043A\u043B\u0430\u0434\u043E\u043C \u0447\u0442\u043E-\u0442\u043E \u0435\u0441\u0442\u044C.
    \u041E\u043D\u043E \u0441\u043A\u0440\u0435\u0431\u0451\u0442\u0441\u044F \u0432\u0441\u044E
    \u043D\u043E\u0447\u044C \u0438 \u043F\u043E\u043B\u0437\u0451\u0442 \u043D\u0430
    \u0437\u0432\u0443\u043A \u043C\u043E\u0435\u0439 \u0442\u0435\u043B\u0435\u0436\u043A\u0438.
    \u041C\u043D\u0435 \u043D\u0435 \u043C\u0435\u0440\u0435\u0449\u0438\u0442\u0441\u044F.\n\n\u042F
    \u043F\u0440\u043E\u0441\u0438\u043B \u0437\u0430\u0432\u0430\u0440\u0438\u0442\u044C
    \u0432\u0435\u043D\u0442\u0438\u043B\u044F\u0446\u0438\u044E. \u041D\u0438\u043A\u0442\u043E
    \u043D\u0435 \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442."
