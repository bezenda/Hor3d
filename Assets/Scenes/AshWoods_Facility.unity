--- !u!114 &618890852
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 618890850}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8559d1e585ee54143b906361e7f3790b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AshenWoods.Interaction.InfoPoint
  prompt: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C \u043F\u043E\u0440\u044F\u0434\u043E\u043A
    \u0432\u0435\u043D\u0442\u0438\u043B\u0435\u0439"
  message: "\u041D\u0430\u0441\u043E\u0441\u044B \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442
    \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0442 \u041E\u0421\u041D\u041E\u0412\u041D\u041E\u0413\u041E
    \u043F\u0438\u0442\u0430\u043D\u0438\u044F (\u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440\u0430).\n\n\u041E\u0442\u043A\u0440\u044B\u0432\u0430\u0442\u044C
    \u0432\u0435\u043D\u0442\u0438\u043B\u0438 \u0441\u0442\u0440\u043E\u0433\u043E
    \u0432 \u042D\u0422\u041E\u041C \u043F\u043E\u0440\u044F\u0434\u043A\u0435:\n\n             
    <b>{valves}</b>\n\n\u041F\u0435\u0440\u0435\u043F\u0443\u0442\u0430\u0435\u0448\u044C
    \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u2014 \u0431\u0443\u0434\u0435\u0442
    \u0433\u0438\u0434\u0440\u043E\u0443\u0434\u0430\u0440. \u0412\u0441\u0451 \u0437\u0430\u043A\u0440\u043E\u0435\u0442\u0441\u044F,
    \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u043D\u0430\u0447\u0438\u043D\u0430\u0442\u044C
    \u0437\u0430\u043D\u043E\u0432\u043E, \u0430 \u0433\u0440\u043E\u0445\u043E\u0442
    \u0440\u0430\u0437\u043D\u0435\u0441\u0451\u0442\u0441\u044F \u043F\u043E \u0432\u0441\u0435\u0439
    \u0441\u0442\u0430\u043D\u0446\u0438\u0438.\n\n\u041A\u043E\u0433\u0434\u0430
    \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043F\u043E\u0434\u043D\u0438\u043C\u0435\u0442\u0441\u044F,
    \u043C\u043E\u0436\u043D\u043E \u0431\u0443\u0434\u0435\u0442 \u043E\u0442\u043A\u0440\u044B\u0442\u044C
    \u0432\u043E\u0440\u043E\u0442\u0430 \u0432 \u0441\u0431\u043E\u0440\u043E\u0447\u043D\u043E\u043C
    \u0446\u0435\u0445\u0435. \u042D\u0442\u043E \u0434\u043E\u043B\u0433\u043E.
    \u0418 \u0433\u0440\u043E\u043C\u043A\u043E."
  showAsSheet: 1
  sheetTitle: "\u0413\u0418\u0414\u0420\u0410\u0412\u041B\u0418\u041A\u0410 \u0412\u041E\u0420\u041E\u0422
    \u2014 \u041F\u0415\u0420\u0415\u0417\u0410\u041F\u0423\u0421\u041A"
  showMap: 0
  markEnemies: 0
  useNoise: 0
  journalLine: "\u041F\u043E\u0440\u044F\u0434\u043E\u043A \u0432\u0435\u043D\u0442\u0438\u043B\u0435\u0439
    (\u043A\u043E\u043C\u043D\u0430\u0442\u0430 \u043F\u043E\u0434 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u0449\u0438\u0442\u043E\u0432\u043E\u0439):
    <b>{valves}</b>"
  loreId: 
  needsPower: 0
  unpoweredPrompt: "\u041D\u043E\u0443\u0442\u0431\u0443\u043A (\u043D\u0435\u0442
    \u043F\u0438\u0442\u0430\u043D\u0438\u044F)"
  unpoweredMessage: "\u041D\u0435 \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F.
    \u0412\u043E \u0432\u0441\u0451\u043C \u0437\u0434\u0430\u043D\u0438\u0438 \u043D\u0435\u0442
    \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u0430."
  screen: {fileID: 0}
  screenOff: {fileID: 0}
  screenOn: {fileID: 0}
