  m_Script: {fileID: 11500000, guid: 8559d1e585ee54143b906361e7f3790b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AshenWoods.Interaction.InfoPoint
  prompt: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C \u0436\u0443\u0440\u043D\u0430\u043B"
  message: "\u0421 \u044D\u0442\u043E\u0439 \u043C\u0438\u043D\u0443\u0442\u044B
    \u0432\u043E \u0432\u0441\u0435\u0445 \u0446\u0435\u0445\u0430\u0445 \u2014 \u0420\u0415\u0416\u0418\u041C
    \u0422\u0418\u0428\u0418\u041D\u042B.\n\n\u041D\u0435 \u0431\u0435\u0433\u0430\u0442\u044C.
    \u041D\u0435 \u0440\u043E\u043D\u044F\u0442\u044C \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442.
    \u041D\u0438\u043A\u0430\u043A\u0438\u0445 \u0440\u0430\u0446\u0438\u0439.\n\u0415\u0441\u043B\u0438
    \u043F\u043E\u0433\u0430\u0441 \u0441\u0432\u0435\u0442 \u2014 \u043E\u0441\u0442\u0430\u0432\u0430\u0439\u0442\u0435\u0441\u044C
    \u043D\u0430 \u043C\u0435\u0441\u0442\u0435 \u0438 \u043D\u0435 \u0434\u0432\u0438\u0433\u0430\u0439\u0442\u0435\u0441\u044C.\n\n\u0412
    \u0442\u0435\u043C\u043D\u043E\u0442\u0435 \u043E\u043D\u043E \u0432\u0438\u0434\u0438\u0442
    \u043F\u043B\u043E\u0445\u043E. \u0415\u043C\u0443 \u044D\u0442\u043E \u0438
    \u043D\u0435 \u043D\u0443\u0436\u043D\u043E.\n\n\u2014 \u042D. \u0425\u0435\u0439\u043B"
  showAsSheet: 1
  sheetTitle: "\u041F\u0410\u041C\u042F\u0422\u041A\u0410 \u0414\u041B\u042F \u0412\u0421\u0415\u0413\u041E
    \u041F\u0415\u0420\u0421\u041E\u041D\u0410\u041B\u0410"
  showMap: 0
  markEnemies: 0
  useNoise: 0
  journalLine: 
  loreId: log_silence
  needsPower: 0
  unpoweredPrompt: "\u041D\u043E\u0443\u0442\u0431\u0443\u043A (\u043D\u0435\u0442
    \u043F\u0438\u0442\u0430\u043D\u0438\u044F)"
  unpoweredMessage: "\u041D\u0435 \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F.
    \u0412\u043E \u0432\u0441\u0451\u043C \u0437\u0434\u0430\u043D\u0438\u0438 \u043D\u0435\u0442
    \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u0430."
