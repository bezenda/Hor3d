  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8559d1e585ee54143b906361e7f3790b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AshenWoods.Interaction.InfoPoint
  prompt: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C \u0436\u0443\u0440\u043D\u0430\u043B"
  message: "\u0425\u0435\u0439\u043B \u0441\u043F\u0443\u0441\u0442\u0438\u043B\u0430\u0441\u044C
    \u0441\u0430\u043C\u0430. \u0421\u0435\u0432\u0435\u0440\u043D\u0443\u044E \u0432\u0435\u043D\u0442\u0438\u043B\u044F\u0446\u0438\u044E
    \u0437\u0430\u0432\u0430\u0440\u0438\u0442\u044C \u0441\u0435\u0433\u043E\u0434\u043D\u044F
    \u0436\u0435 \u043D\u043E\u0447\u044C\u044E, \u0431\u0435\u0437 \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u0432,
    \u043E\u043F\u043B\u0430\u0442\u0430 \u0434\u0432\u043E\u0439\u043D\u0430\u044F.\n\n\u0420\u043E\u0441\u0441
    \u0441\u043F\u0440\u043E\u0441\u0438\u043B, \u0447\u0442\u043E \u0434\u0435\u0440\u0436\u0430\u0442
    \u0432 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438. \u041E\u043D\u0430
    \u0432\u0435\u043B\u0435\u043B\u0430 \u0435\u043C\u0443 \u0438\u0434\u0442\u0438
    \u0434\u043E\u043C\u043E\u0439. \u0414\u043E\u043C\u043E\u0439 \u043E\u043D \u043D\u0435
    \u043F\u043E\u0448\u0451\u043B."
  showAsSheet: 1
  sheetTitle: "\u0411\u0420\u0418\u0413\u0410\u0414\u0418\u0420 \u2014 \u041D\u041E\u0427\u041D\u0410\u042F
    \u0421\u041C\u0415\u041D\u0410"
  showMap: 0
  markEnemies: 0
  useNoise: 0
  journalLine: 
  loreId: log_foreman
  needsPower: 0
  unpoweredPrompt: "\u041D\u043E\u0443\u0442\u0431\u0443\u043A (\u043D\u0435\u0442
    \u043F\u0438\u0442\u0430\u043D\u0438\u044F)"
  unpoweredMessage: "\u041D\u0435 \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F.
    \u0412\u043E \u0432\u0441\u0451\u043C \u0437\u0434\u0430\u043D\u0438\u0438 \u043D\u0435\u0442
    \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u0430."
