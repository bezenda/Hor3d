  m_Script: {fileID: 11500000, guid: 45e98a11548f40728f6fb70d95a3709a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AshenWoods.Interaction.PuzzleController
  switches:
  - {fileID: 408779266}
  switchesRequired: 0
  requiredItemId: fuel_1,fuel_2
  consumeItems: 1
  prerequisite: {fileID: 1981057909}
  prerequisitePrompt: "\u0413\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440 (\u043D\u0435\u0442
    \u043F\u0438\u0442\u0430\u043D\u0438\u044F \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F)"
  prerequisiteMessage: "\u0421\u0442\u0430\u0440\u0442\u0435\u0440 \u043D\u0435 \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442
    \u2014 \u043D\u0435\u0442 \u043F\u0438\u0442\u0430\u043D\u0438\u044F \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F.
    \u0412\u0438\u0434\u0438\u043C\u043E, \u0440\u0443\u0431\u0438\u043B\u044C\u043D\u0438\u043A\u0438
    \u043D\u0430 \u0449\u0438\u0442\u0435 \u043E\u043F\u0443\u0449\u0435\u043D\u044B."
  ordered: 0
  shuffleOrder: 1
  orderToken: 
  wrongOrderMessage: "\u041D\u0435 \u0442\u043E\u0442 \u0432\u0435\u043D\u0442\u0438\u043B\u044C.
    \u0414\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043F\u0430\u0434\u0430\u0435\u0442
    \u0441 \u0433\u0440\u043E\u0445\u043E\u0442\u043E\u043C \u2014 \u043D\u0430\u0447\u0438\u043D\u0430\u0439
    \u0437\u0430\u043D\u043E\u0432\u043E."
  wrongOrderNoise: 0.6
  solvedMessage: "\u0422\u043E\u043F\u043B\u0438\u0432\u043E \u0437\u0430\u043B\u0438\u0442\u043E,
    \u0441\u0442\u0430\u0440\u0442\u0435\u0440 \u0434\u0451\u0440\u043D\u0443\u0442.
    \u0413\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440 \u043A\u0430\u0448\u043B\u044F\u0435\u0442
    \u0438 \u0440\u0435\u0432\u0451\u0442 \u2014 \u043F\u043E \u0432\u0441\u0435\u0439
    \u0441\u0442\u0430\u043D\u0446\u0438\u0438, \u043C\u0438\u0433\u0430\u044F, \u0437\u0430\u0433\u043E\u0440\u0430\u0435\u0442\u0441\u044F
    \u0441\u0432\u0435\u0442. \u042D\u0442\u043E \u0441\u043B\u044B\u0448\u0430\u043B\u0438
    \u0432\u0441\u0435."
  lockedPrompt: "\u0413\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440 (\u043D\u0435\u0442
    \u0442\u043E\u043F\u043B\u0438\u0432\u0430)"
  lockedMessage: "\u0411\u0430\u043A \u0441\u0443\u0445\u043E\u0439. \u0414\u0432\u0443\u0445
    \u043A\u0430\u043D\u0438\u0441\u0442\u0440 \u0434\u043E\u043B\u0436\u043D\u043E
