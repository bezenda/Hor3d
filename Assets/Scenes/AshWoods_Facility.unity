--- !u!114 &1592314719
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1592314717}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8559d1e585ee54143b906361e7f3790b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AshenWoods.Interaction.InfoPoint
  prompt: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C \u0436\u0443\u0440\u043D\u0430\u043B"
  message: "\u041F\u0438\u0442\u0430\u043D\u0438\u0435 \u044F \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u043B\u0430
    \u0441\u0430\u043C\u0430. \u042F \u0441\u043F\u0440\u044F\u0442\u0430\u043B\u0430
    \u043A\u043E\u0434, \u0441\u043B\u0438\u043B\u0430 \u0442\u043E\u043F\u043B\u0438\u0432\u043E,
    \u0437\u0430\u043F\u0435\u0440\u043B\u0430 \u0432\u043E\u0440\u043E\u0442\u0430.\n\n\u0415\u0441\u043B\u0438
    \u043E\u043D\u043E \u0434\u043E\u0431\u0435\u0440\u0451\u0442\u0441\u044F \u0434\u043E
    \u043B\u0435\u0441\u0430, \u043E\u043D\u043E \u0434\u043E\u0431\u0435\u0440\u0451\u0442\u0441\u044F
    \u0438 \u0434\u043E \u0433\u043E\u0440\u043E\u0434\u0430.\n\n\u041A\u0442\u043E
    \u0431\u044B \u0442\u044B \u043D\u0438 \u0431\u044B\u043B: \u0435\u0441\u043B\u0438
    \u043E\u0442\u043A\u0440\u043E\u0435\u0448\u044C \u0432\u043E\u0440\u043E\u0442\u0430,
    \u0443\u0431\u0435\u0434\u0438\u0441\u044C, \u0447\u0442\u043E \u043D\u0430\u0440\u0443\u0436\u0443
    \u0432\u044B\u0439\u0434\u0435\u0448\u044C \u0442\u043E\u043B\u044C\u043A\u043E
    \u0442\u044B."
  showAsSheet: 1
  sheetTitle: "\u042D. \u0425\u0415\u0419\u041B \u2014 \u041B\u0418\u0427\u041D\u041E\u0415"
  showMap: 0
  markEnemies: 0
  useNoise: 0
  journalLine: 
  loreId: log_hale
  needsPower: 0
  unpoweredPrompt: "\u041D\u043E\u0443\u0442\u0431\u0443\u043A (\u043D\u0435\u0442
    \u043F\u0438\u0442\u0430\u043D\u0438\u044F)"
  unpoweredMessage: "\u041D\u0435 \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F.
    \u0412\u043E \u0432\u0441\u0451\u043C \u0437\u0434\u0430\u043D\u0438\u0438 \u043D\u0435\u0442
    \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u0430."
